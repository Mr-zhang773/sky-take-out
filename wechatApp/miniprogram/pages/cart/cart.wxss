page {
  background: #f5f5f5;
  height: 100vh;
}

.cart-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.empty-cart {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  font-size: 120rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-top: 20rpx;
}

.go-shopping {
  margin-top: 30rpx;
  background: #FF6B35;
  color: #fff;
  border-radius: 40rpx;
  padding: 20rpx 60rpx;
  font-size: 28rpx;
  border: none;
}

.go-shopping::after {
  border: none;
}

.cart-list {
  flex: 1;
  padding: 20rpx;
  padding-bottom: 120rpx;
}

.cart-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.cart-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.cart-info {
  flex: 1;
  padding-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.cart-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.cart-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF6B35;
}

.quantity-control {
  display: flex;
  align-items: center;
  align-self: flex-end;
}

.qty-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #FF6B35;
  color: #fff;
  text-align: center;
  line-height: 52rpx;
  font-size: 36rpx;
}

.qty-num {
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333;
}

.cart-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05);
}

.total {
  font-size: 32rpx;
  color: #333;
}

.price {
  color: #FF6B35;
  font-weight: 700;
}

.checkout-btn {
  background: #FF6B35;
  color: #fff;
  border-radius: 40rpx;
  padding: 16rpx 50rpx;
  font-size: 28rpx;
  border: none;
}

.checkout-btn::after {
  border: none;
}