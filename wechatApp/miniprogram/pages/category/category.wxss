/* pages/category/category.wxss */page {
  height: 100vh;
  background: #f5f5f5;
}

.category-page {
  display: flex;
  height: 100vh;
  padding-bottom: 100rpx;
}

/* ===== 左侧分类 ===== */
.left-menu {
  width: 180rpx;
  height: 100vh;
  background: #fff;
  flex-shrink: 0;
}

.menu-item {
  padding: 30rpx 20rpx;
  font-size: 28rpx;
  color: #666;
  text-align: center;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item.active {
  color: #FF6B35;
  background: #f5f5f5;
  font-weight: 600;
  border-left: 6rpx solid #FF6B35;
}

/* ===== 右侧菜品 ===== */
.right-content {
  flex: 1;
  padding: 20rpx;
  padding-bottom: 20rpx;
  height: 100vh;
}

.dish-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.dish-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.dish-info {
  flex: 1;
  padding: 0 20rpx;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.dish-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF6B35;
}

.add-btn {
  width: 56rpx;
  height: 56rpx;
  background: #FF6B35;
  border-radius: 50%;
  color: #fff;
  font-size: 40rpx;
  text-align: center;
  line-height: 56rpx;
  flex-shrink: 0;
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* ===== 底部购物车 ===== */
.cart-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #2d2d2d;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 30rpx;
  height: 100rpx;
  border-radius: 20rpx 20rpx 0 0;
  z-index: 999;
}

.cart-left {
  display: flex;
  align-items: center;
}

.cart-icon-wrapper {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  background: #FF6B35;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.cart-icon {
  font-size: 36rpx;
}

.cart-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: #FF2D2D;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
}

.cart-total {
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}

.cart-right {
  background: #FF6B35;
  color: #fff;
  padding: 16rpx 50rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}
/* 弹窗遮罩 */
.cart-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1000;
}

/* 弹窗 */
.cart-popup {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 60vh;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  z-index: 1001;
  display: flex;
  flex-direction: column;
}

.cart-popup.active {
  transform: translateY(0);
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.popup-title {
  font-size: 34rpx;
  font-weight: 700;
}

.popup-close {
  font-size: 40rpx;
  color: #999;
}

.popup-body {
  flex: 1;
  padding: 0 40rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.popup-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

.popup-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.popup-name {
  font-size: 28rpx;
  flex: 1;
}

.popup-control {
  display: flex;
  align-items: center;
  margin: 0 20rpx;
}

.popup-btn {
  width: 48rpx;
  height: 48rpx;
  background: #FF6B35;
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 48rpx;
  font-size: 32rpx;
}

.popup-qty {
  padding: 0 20rpx;
  font-size: 28rpx;
}

.popup-price {
  font-size: 28rpx;
  font-weight: 600;
  color: #FF6B35;
  width: 120rpx;
  text-align: right;
}

.popup-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 40rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.popup-total {
  font-size: 30rpx;
  font-weight: 700;
}

.popup-checkout {
  background: #FF6B35;
  color: #fff;
  border-radius: 40rpx;
  padding: 16rpx 50rpx;
  font-size: 28rpx;
  border: none;
}

.popup-checkout::after {
  border: none;
}

.category-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  padding: 20rpx 0 10rpx;
  background: #f5f5f5;
  position: sticky;
  top: 0;
  z-index: 10;
}
.popup-image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}